        D0["Laravel Livewire<br/>+ PhpSpreadsheet + Chart.js"]
        
        subgraph MODUL["Modul Ekspor & Analitik (FOKUS)"]
            D1["📊 Dashboard Monitoring<br/>Progres Pengisian"]
            D2["🔍 Filter & Visualisasi<br/>Data Responden"]
            D3["📤 Ekspor Excel<br/>(dengan template)"]
