            D5["📄 Ekspor Format<br/>Kementerian"]
            D6["🔄 Mapping Representasi<br/>Pertanyaan/Jawaban"]
        end
        
        D0 --> MODUL
    end

    subgraph FASE5["<b>FASE 5: Pengujian & Evaluasi</b>"]
        E1["Pengujian Fungsional<br/>(Black Box Testing)"]
        E2["Validasi Format Ekspor<br/>(BAN-PT & Kementerian)"]
        E3["User Acceptance<br/>Testing (UAT)"]
        E1 --> E2
        E2 --> E3
