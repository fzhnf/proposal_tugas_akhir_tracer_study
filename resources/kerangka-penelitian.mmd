        B2["Analisis Kebutuhan:<br/>• Wawancara Stakeholder<br/>• User Story Mapping<br/>• Analisis Format Pelaporan"]
        B1 --> B2
    end

    subgraph FASE3["<b>FASE 3: Perancangan Sistem</b>"]
        C1["Desain Arsitektur<br/>Modul Ekspor & Analitik"]
        C2["Desain Skema<br/>Data Agregasi"]
        C3["Desain Antarmuka<br/>Dashboard"]
        C4["Desain Mapping<br/>Format Pelaporan"]
        C1 --> C2
        C2 --> C3
        C3 --> C4
    end

    subgraph FASE4["<b>FASE 4: Implementasi Prototipe</b>"]
