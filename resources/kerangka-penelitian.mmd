    F3 --> OUTPUT[("📦 OUTPUT:<br/>• Modul Ekspor & Analitik<br/>• Laporan TA<br/>• Artikel Ilmiah<br/>• Sertifikat HKI")]

    %% Styling
    classDef fase fill:#e3f2fd,stroke:#1976d2,stroke-width:2px
    classDef problem fill:#ffebee,stroke:#c62828,stroke-width:2px
    classDef output fill:#e8f5e9,stroke:#2e7d32,stroke-width:3px
    classDef modul fill:#fff8e1,stroke:#f57f17,stroke-width:1px
    
    class A1 problem
    class OUTPUT output
    class D1,D2,D3,D4,D5,D6 modul
